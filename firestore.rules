rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users - cada usuário só lê/escreve seus próprios dados
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // players - leitura pública, escrita autenticada
    match /players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // teams - legado, manter por compatibilidade
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    // match_lineups - cada usuário só lê/escreve suas próprias escalações (userId == auth.uid)
    // resource == null: permite getDoc quando o doc ainda não existe (usuário checando se tem escalação)
    match /match_lineups/{docId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // matches - leitura pública, escrita autentada
    match /matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // player_match_stats, match_points, user_match_points, leaderboard
    match /player_match_stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /match_points/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /user_match_points/{docId} {
      allow read, write: if request.auth != null;
    }
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // leagues - dono cria/atualiza; membros leem
    match /leagues/{leagueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // premium_requests - usuário pode criar/atualizar apenas seu próprio pedido
    match /premium_requests/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow read, delete: if false;
    }
  }
}
